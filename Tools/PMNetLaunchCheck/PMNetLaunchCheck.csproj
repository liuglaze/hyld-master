<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      计划 P2' 的门禁：启动参数解析与进程网络模式判定。

      为什么单独建一个工程而不是塞进 PMNetVerify：
      PMNetVerify 是「线格式逐字节等价」的对照实验（T2），关心的是序列化；
      本工程关心的是启动期身份判定，两者没有共同的被测对象，混在一起会让两个门禁都失去单一职责。

      这里的价值在于：DS 只有靠命令行参数才能与客户端区分（Unity 2019.4 没有 UNITY_SERVER，
      见计划 §2.8），所以「参数 → 进程形态」这条契约是 P2' 乃至 P3'/P4' 的地基。
      它一旦错，表现是「DS 起来后按客户端跑」，且没有任何编译期信号。
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>PMNetLaunchCheck</AssemblyName>
    <RootNamespace>PMNetLaunchCheck</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 与 T1 同口径：证明被测代码没有越过 Unity 2019.4 的 C# 7.3 语言面。 -->
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      PMNet 核心（含 PMNetLaunchOptions / PMNetRuntime）：直接编译客户端 Assets 下的同一份源码，
      不做副本，避免该契约在客户端/服务端之间分叉。
    -->
    <Compile Include="..\..\Client\Assets\Scripts\PMNet\**\*.cs" LinkBase="PMNet" />
  </ItemGroup>

</Project>
