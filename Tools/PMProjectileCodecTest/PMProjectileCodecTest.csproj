<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      R5-B1 验收（T5B1）：独立线协议 codec 的真实字节测试（net8.0）。

      为什么需要它：
        「每类载荷全字段往返」「required 缺失/乱序/重复/未知/wire 错/截断/长度前缀超限/NaN/Inf/
        key 非法/origin 非法/身份非法全部被拒」「上行载荷注入权威字段（spec/AuthorityNetId）必拒」
        「快照权威 ID=0 必拒」「数组 > 100 必拒」「Snapshot.Clone 数组隔离」「Decision 不接受 Pending 伪终态」
        —— 这些性质编译期完全看不出来，运行期又都长得像「偶发的一颗幽灵子弹 / 偶发的权威校验被绕过」。
        这里把它们钉成可执行断言。

      做法：
        · 直接编**真实生产 codec**（与 PMProjectileCodecCheck 编的是同一份文件）；
        · 负向用例用**测试侧独立手写的字段级字节**（自己写 header/tag/varint/float），
          而不是「拿 codec 自己的编码器造一个坏载荷」—— 这样解码器有一个独立对照；
        · 截断用例对每个合法载荷**逐字节截断**，并要求「返回 false 且不抛异常」；
        · 正向用例额外做 `encode(decode(encode(x))) == encode(x)` 的字节级往返（正反字段一致）。

      明确不测（诚实边界）：
        · 真实 PMR3 RPC 传输 / 生成桩 byte[] 上限 / Unity 宿主 / 双端实机 —— 属 B2/C 与 T45（PENDING_USER）；
        · L0–L4 几何与预算判定（segment ≤ 20m、visualOffset ≤ 20m、空命中批、白名单、飞行预算）
          —— 属 A2 的 PMProjectileValidator，本工程不冒充。

      运行：dotnet Tools/PMProjectileCodecTest/bin/Release/net8.0/PMProjectileCodecTest.dll
      退出码：0 = 全部通过；1 = 存在失败
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>PMProjectileCodecTest</AssemblyName>
    <RootNamespace>PMProjectileCodecTest</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />

    <!-- 真实实现 + 冻结契约（与 PMProjectileCodecCheck 编的是同一份文件） -->
    <Compile Include="..\..\Client\Assets\Scripts\PMProjectile\PMProjectileContracts.cs" LinkBase="PMProjectile" />
    <Compile Include="..\..\Client\Assets\Scripts\PMProjectile\PMProjectileCodec.cs" LinkBase="PMProjectile" />
    <Compile Include="..\..\Client\Assets\Scripts\PMNet\PMNetReader.cs" LinkBase="PMNet" />
    <Compile Include="..\..\Client\Assets\Scripts\PMNet\PMNetWriter.cs" LinkBase="PMNet" />
    <Compile Include="..\..\Client\Assets\Scripts\PMNet\PMNetIdentity.cs" LinkBase="PMNet" />
    <Compile Include="..\..\Client\Assets\Scripts\PMNet\PMWireType.cs" LinkBase="PMNet" />
    <Compile Include="..\..\Client\Assets\Scripts\PMMover\PMMoverState.cs" LinkBase="PMMover" />
  </ItemGroup>

</Project>
