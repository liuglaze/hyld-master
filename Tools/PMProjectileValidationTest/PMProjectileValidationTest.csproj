<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      R5-A2 验收（T5A4 / T5A5）：目标历史与命中验证纯核心的真实运行测试（net8.0）。

      为什么需要它：
        「帧锚新鲜度按 TotalSimTimeMs 而非帧差×16」「同宿主帧多输入取最后输出」
        「旧流/跨 epoch 不退化到另一世代」「Teleport 不插值」「L2 三分支」「skip 只跳飞行」
        「ImpactPoint 只钳不拒」「目标尺寸逐目标独立」「白名单/去重」「Pending 不结算」
        —— 这些性质编译期完全看不出来，运行期又都长得像「偶尔少一次伤害 / 偶尔多一次伤害」。
        这里把每一条钉成可执行断言，预期值由独立手算给出。

      直接编**真实实现**（与 PMProjectileValidationCheck 同一份文件面），不引 Unity、不引生成器：
        · Client/Assets/Scripts/PMProjectile/PMProjectileContracts.cs（共享只读契约）
        · Client/Assets/Scripts/PMProjectile/PMProjectileHistory.cs（本组）
        · Client/Assets/Scripts/PMProjectile/PMProjectileValidator.cs（本组）
        · Client/Assets/Scripts/PMNet/PMNetIdentity.cs（PMFrameId / PMFrameDomain）
        · Client/Assets/Scripts/PMMover/PMMoverState.cs（PMVector3）

      诚实边界：本测试只覆盖纯核心（T5A4/T5A5）。真实 RPC/复制/Unity 宿主/双端实机属于
      B/C 阶段与 T45（PENDING_USER），本工程不冒充它们已验收。

      运行：dotnet Tools/PMProjectileValidationTest/bin/Release/net8.0/PMProjectileValidationTest.dll
      退出码：0 = 全部通过；1 = 存在失败
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>PMProjectileValidationTest</AssemblyName>
    <RootNamespace>PMProjectileValidationTest</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Client\Assets\Scripts\PMProjectile\PMProjectileContracts.cs" LinkBase="PMProjectile" />
    <Compile Include="..\..\Client\Assets\Scripts\PMProjectile\PMProjectileHistory.cs" LinkBase="PMProjectile" />
    <Compile Include="..\..\Client\Assets\Scripts\PMProjectile\PMProjectileValidator.cs" LinkBase="PMProjectile" />
    <Compile Include="..\..\Client\Assets\Scripts\PMNet\PMNetIdentity.cs" LinkBase="PMNet" />
    <Compile Include="..\..\Client\Assets\Scripts\PMMover\PMMoverState.cs" LinkBase="PMMover" />
  </ItemGroup>

</Project>
