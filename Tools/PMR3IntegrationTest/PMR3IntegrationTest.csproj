<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      R3-B5 主集成门禁：Lobby→DS 控制面 + 真实 UDP 两客户端数据面（**有界非 Unity 测试宿主**）。

      为什么需要它：
        R3B2/R3B3/R3B4 各自只到自己那一段的边界（UDP 准入 / Lobby 控制 listener / PMR3 声明产物）。
        「Lobby 真的写引导文件 → 真的 DS 控制代理拿它连回来上报 Ready → Lobby 真的发 PMDS1 offer
         → 两个客户端真的经 PMDsEntryCodec 解码后 OpenClient → 真 UDP 上握手/复制/RPC 收敛
         → 真结果 RPC 上行 → ResultAck → DS 显式 Exited(0) → 进程退出 → Lobby 回收端口与 uid」
        这条**跨模块闭环**在编译期完全看不出来，只能在同一进程里把真实组件接起来跑。

      它编的都是**真实实现**（不引 UnityEngine、不引 Server 主类型）：
        - Client/Assets/Scripts/PMNet/**（Control/Session/Transport/World/Replication/Generated）；
        - Client/Assets/Scripts/PMR3/**（声明对象 + 由 PMNetGen 生成的注册表/桩）；
        - Client/Assets/Scripts/Server/Boot/PMDsLobbyAgent.cs（纯 C# 的 DS 控制代理）；
        - Server/DS/**（PMDsCoordinator / PMDsProcess / PMDsPlayerLedger / PMDsControlListener / PMDsLobbyHost）。

      **唯一边界外替身 = 受控进程替身**（IPMDsProcessLauncher/IPMDsProcess）：不拉起真实
      HyldDS.exe（那需要 Unity 构建，属 T42）。因此本门禁的结论只覆盖控制面与数据面接线，
      **不代表真实 Unity DS 能启动**；`PMDsSessionHost`/`PMClientSessionHost`（Unity 宿主）
      不在此编译，由本门禁的测试宿主按同一次序复刻其非 Unity 核心。

      网络全部是真实回环：真实 TCP（控制通道）+ 真实 UDP（入局/复制/RPC），端口用系统临时端口与
      随机高位端口段，不碰 7777/7778/7800。

      运行：dotnet Tools/PMR3IntegrationTest/bin/Release/net8.0/PMR3IntegrationTest.dll
      退出码：0 = 全部通过；1 = 存在失败
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>PMR3IntegrationTest</AssemblyName>
    <RootNamespace>PMR3IntegrationTest</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />

    <!-- 真实 PMNet 核心（含 Control/Session/Transport/World/Replication/Generated）。 -->
    <Compile Include="..\..\Client\Assets\Scripts\PMNet\**\*.cs" LinkBase="PMNet" />

    <!-- R3-B 声明对象 + 生成产物（PMR3 在 PMNet 目录之外，避免注册表重名）。 -->
    <Compile Include="..\..\Client\Assets\Scripts\PMR3\PMR3Player.cs" LinkBase="PMR3" />
    <Compile Include="..\..\Client\Assets\Scripts\PMR3\PMR3Runtime.cs" LinkBase="PMR3" />
    <Compile Include="..\..\Client\Assets\Scripts\PMR3\Generated\**\*.cs" LinkBase="PMR3\Generated" />

    <!-- 纯 C# 的 DS 侧控制代理（Unity 宿主里也用它，这里直接测同一份源码）。 -->
    <Compile Include="..\..\Client\Assets\Scripts\Server\Boot\PMDsLobbyAgent.cs" LinkBase="Boot" />

    <!-- Server/DS 全部源：协调器/进程抽象/uid 账本/控制 listener/Lobby 宿主（均无 Unity 依赖）。 -->
    <Compile Include="..\..\Server\DS\**\*.cs" LinkBase="Server\DS" />
  </ItemGroup>

</Project>
