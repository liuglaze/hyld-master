<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      P3'-2 门禁：共享战斗数值表（Client/Assets/Scripts/Shared/BattleNumericConfig.cs）的编译校验。

      为什么需要它：
      这个文件会被**服务端与 Unity 客户端同时编译**（服务端用 <Compile Include> 链接同一份源码）。
      如果它引用了 UnityEngine，服务端立刻编不过；如果它用了超出 Unity 2019.4 的语言特性，
      客户端编不过。这两种失败都不该等到「在 Unity 里构建」或「编译服务端」时才暴露。

      因此这里刻意做到：
        1) netstandard2.0 + C# 7.3 —— 与 Unity 2019.4 的编译能力上限一致；
        2) **零依赖** —— 不引用 Google.Protobuf、不引用 UnityEngine、不引用任何项目内其他代码。
           这正是「用 int heroId 而不是枚举键」这个设计换来的好处：
           连 protobuf 生成物都不需要，门禁才能这么严格。

      注意它同时覆盖了目录下所有内容（当前只有这一个文件；将来往 Shared/ 加东西会自动纳入）。
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>PMSharedConfigCheck</AssemblyName>
    <RootNamespace>PMSharedConfigCheck</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Client\Assets\Scripts\Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
