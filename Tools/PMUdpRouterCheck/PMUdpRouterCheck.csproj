<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      P3'-1 门禁：DS 战斗 UDP 路由层（PMUdpRouter / PMSingleBattleRegistry）的编译校验。

      为什么需要这个门禁：
      这三个文件只能在 Unity 里真正编译，而 Unity 编辑器在跑时持有工程锁、
      无法再起第二个 CLI 实例；因此「改一行等一次用户手工构建」是不可接受的反馈周期。
      本工程用与被编译代码**完全相同的语言面**（netstandard2.0 + C# 7.3，即 Unity 2019.4 的天花板）
      把语法、类型、API 可用性问题提前暴露出来。

      覆盖范围：
        - Client/Assets/Scripts/Server/Net/*.cs          （P3'-1 新增的路由层）
        - Client/Assets/Scripts/Server/SocketProto.cs    （权威 protoc 产物，提供 MainPack/ActionCode）

      注意它**不引用 UnityEngine**：这正是设计约束 —— 路由层必须保持 UnityEngine 无关，
      日志通过注入的回调输出。若有人往这些文件里加了 UnityEngine 依赖，本门禁会立刻失败。
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>PMUdpRouterCheck</AssemblyName>
    <RootNamespace>PMUdpRouterCheck</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Google.Protobuf">
      <HintPath>..\..\Client\Assets\Scripts\Google.Protobuf.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Client\Assets\Scripts\Server\Net\**\*.cs" LinkBase="Net" />
    <Compile Include="..\..\Client\Assets\Scripts\Server\SocketProto.cs" LinkBase="Proto" />
  </ItemGroup>

</Project>
